{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  
  "env": {
    "VITE_API_BASE_URL_1": "https://api.swiftlyxpress.com",
        "VITE_API_BASE_URL": "https://wise-grub-formally.ngrok-free.app"
  }
}
